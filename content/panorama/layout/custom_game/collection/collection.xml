<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c"/>
		<include src="file://{resources}/layout/custom_game/collection/collection_precache.css"/>
		<include src="file://{resources}/layout/custom_game/collection/collection.css"/>
	</styles>

	<scripts>
		<include src="file://{resources}/layout/custom_game/scripts/utils.js" />
		<include src="file://{resources}/layout/custom_game/collection/const.js" />
		<include src="file://{resources}/layout/custom_game/collection/config.js" />
		<include src="file://{resources}/layout/custom_game/collection/collection.js"/>
	</scripts>
	<snippets>
		<snippet name="CurrencyButton">
			<Button class="CurrencyButton">
				<Label class="Value" text="{s:value}"/>
				<Image id="Icon"/>
				<Image id="ActiveButton"/>
			</Button>
		</snippet>
		<snippet name="Tab">
			<Button class="Tab">
				<Panel class="Overlay"/>
				<Panel class="TabInfo">
					<Image id="Icon" src="file://{images}/custom_game/collection/tab_icon_battle_pass.png"/>
					<Label text="{s:tab_name}"/>
				</Panel>
				<Image class="Tab_Flag" src="file://{images}/custom_game/collection/cosmetics/flag.png"/>
			</Button>
		</snippet>
		<snippet name="C_SubscriptionConf">
			<Panel class="C_SubscriptionConf" onactivate="">
				<Panel class="BC_Wrap">
					<Panel class="BC_Icon"/>
					<Label class="BC_Header" text="{s:sub_name}"/>
					<Panel id="BC_Content"/>

					<Button id="BC_ConfPurchaseButton">
						<Label text="{s:sub_unlock_state}"/>
					</Button>
				</Panel>
				<Label class="BC_Close" text="#close" onactivate="GameUI.Collection.CloseSubPanels()"/>
			</Panel>
		</snippet>
		<snippet name="C_CurrencyBundle">
			<Button class="C_CurrencyBundle">
				<Panel class="CB_Background">
					<Image id="CB_Image"/>
					<Panel class="CB_List_Wrap">
						<Panel id="CB_List"/>
						<Label class="CB_PopularLabel" text="Popular"/>
					</Panel>
					<Button class="CB_Button">
						<Label text="{s:cb_button_text}"/>
					</Button>
				</Panel>
				<Label class="CB_Bonus" text="{d:bonus}% Bonus"/>
			</Button>
		</snippet>
	</snippets>

	<Panel class="Collection_Root" hittest="false">
		<Panel class="Collection_Wrap">
			<Image class="C_Glow" src="file://{images}/custom_game/collection/glow.png">
				<Label text="Collection"/>
			</Image>
			<Panel class="C_Wrap" onactivate="">
				<Panel class="C_TopBar">
					<Panel class="C_PlayerInfoRoot">
						<DOTAAvatarImage id="C_PlayerAvatar" steamid="local"/>
						<Panel>
							<DOTAUserName id="C_PlayerName" steamid="local"/>
							<Label class="C_PlayerSubscriptionState" text="{s:sub_state_text}"/>
						</Panel>
					</Panel>
					<Panel id="C_TopBar_ButtonsRoot"/>
				</Panel>
				<Panel class="C_MainPanelShadow">
					<Panel class="C_SubscriptionButtonsRoot">
						<Button class="C_SubscriptionButton C_SubscriptionButton_1" onactivate="ToggleSubscriptionPurchasing(1)">
							<Image src="file://{images}/custom_game/collection/sub_1.png"/>
							<Label class="C_SubscriptionButton_Header" text="#sub_1"/>
							<Label class="C_SubscriptionButton_Desc" text="#sub_details"/>
						</Button>
						<Button class="C_SubscriptionButton C_SubscriptionButton_2" onactivate="ToggleSubscriptionPurchasing(2)">
							<Image src="file://{images}/custom_game/collection/sub_2.png"/>
							<Label class="C_SubscriptionButton_Header" text="#sub_2"/>
							<Label class="C_SubscriptionButton_Desc" text="#sub_details"/>
						</Button>
					</Panel>
					<Panel class="C_Content_Root">
						<Panel id="C_Tabs"/>
						<Panel id="C_Content"/>
					</Panel>
				</Panel>
			</Panel>

			<Panel id="C_SubPanels">
				<Panel id="C_PayCurrency" onactivate="">
					<Panel class="C_PayCurrency_Header_Wrap">
						<Label class="C_PayCurrency_Close" text="#Close" onactivate="GameUI.Collection.CloseSubPanels()"/>
						<Label class="C_SubPanel_Header" text="#pay_currency_header"/>
						<Label class="C_SubPanel_Header HalloweenHeader" text="#pay_currency_header_halloween_event" html="true"/>

					</Panel>
					<Panel id="C_PayCurrency_Content"/>
					<Label class="C_PayCurrency_BottomHint" text="#currency_shop_hint" html="true"/>
				</Panel>
				<Panel id="PaySubscriptionConf_Root" onactivate=""/>
			</Panel>

			<Button class="CloseCollection" onactivate="ToggleCollectionShow()"/>
		</Panel>
		<Panel id="C_AdditionalPanels" hittest="false" hittest-children="false"/>
	</Panel>
</root>
