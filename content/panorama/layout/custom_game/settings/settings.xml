<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c"/>
		<include src="file://{resources}/layout/custom_game/settings/settings.css"/>
	</styles>

	<scripts>
		<include src="file://{resources}/layout/custom_game/scripts/utils.js" />
		<include src="file://{resources}/layout/custom_game/settings/settings.js"/>
	</scripts>

	<snippets>
		<snippet name="settings_category">
			<Panel class="SettingsCategory">
				<Label class="CategoryName" text="{s:category_name}"/>
			</Panel>
		</snippet>

		<snippet name="settings_checkbox">
			<Panel class="SettingEntry SettingCheckbox">
				<ToggleButton class="CheckBox">
					<Label class="CheckBoxLabel" text="{s:setting_name}" />
				</ToggleButton>
			</Panel>
		</snippet>

		<snippet name="settings_slider">
			<Panel class="SettingEntry SettingSliderContainer">
				<Panel class="SliderLabels">
					<Label id="SliderTitle" text="{s:setting_name}"/>
					<Label id="SliderValue" text="{d:value}"/>
				</Panel>
				<Slider id="SettingsSlider" direction="horizontal" class="HorizontalSlider"/>
			</Panel>
		</snippet>
	</snippets>

	<Panel class="SettingsPanel" hittest="false">
		<Panel class="SettingsHeaderContainer">
			<Label class="SettingsHeader" text="#settings_header"/>
			<Button class="CloseButton" id="CloseButton" onactivate="ToggleSettings()"/>
		</Panel>
		<Panel class="OverlayShadow"/>
		<Panel id="SettingsContainer">

		</Panel>
	</Panel>
</root>
