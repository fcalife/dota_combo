<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c" />
		<include src="file://{resources}/layout/custom_game/promo_events/promo_events.css"/>
		<include src="file://{resources}/layout/custom_game/collection/cosmetics/cosmetics_rarities.css"/>
	</styles>

	<scripts>
		<include src="file://{resources}/layout/custom_game/scripts/utils.js" />
		<include src="file://{resources}/layout/custom_game/promo_events/promo_events_const.js"/>
		<include src="file://{resources}/layout/custom_game/promo_events/promo_events.js"/>
	</scripts>

	<snippets>
		<snippet name="PromoReward">
			<Panel class="PromoReward">
				<Panel class="PR_Border CI_Background">
					<Image id="PR_Icon">
						<Label class="PR_Count" text="{d:reward_amount}"/>
					</Image>
				</Panel>
				<Image class="PR_CheckImage" src="file://{images}/custom_game/promo_events/golden_check.png"/>
			</Panel>
		</snippet>
		<snippet name="PromoGame">
			<Button class="PromoGame">
				<Image id="PG_BG_Image"/>
				<Panel class="PG_Content">
					<Panel class="PG_NameRoot">
						<Label class="PG_Name" text="{s:game_name}"/>
						<Label class="PG_Progress" text="{s:claimed_tasks}/{s:total_tasks}"/>
					</Panel>
					<Image id="PG_Image">
						<Button id="PG_LinkButton"
								onmouseover="DOTAShowTextTooltip(#promo_events_open_game_hint)"
								onmouseout="DOTAHideTextTooltip()"/>
					</Image>
				</Panel>
			</Button>
		</snippet>
		<snippet name="PromoTask">
			<Button class="PromoTask">
				<Image id="PT_Icon"/>
				<Panel class="PT_DescriptionContainer">
					<Panel class="PT_D_GameAndTime">
						<Label class="PT_D_GameName" text="{s:game_name}"/>
						<Label class="PT_D_TimeRemaining" text="{s:task_time_basic}"/>
					</Panel>
					<Panel class="PT_ObjectiveContainer">
						<Label class="PT_Objective" text="{s:objective}"/>
						<Label class="PT_Progress" text=" ( {s:progress}/{s:goal} )"/>
					</Panel>
				</Panel>
				<Panel class="PT_RewardContainer">
					<Panel class="PT_R_BGLine_Claim"/>
					<Panel class="PT_R_BGLine" text="{s:claim_state}">
						<DOTAScenePanel class="PT_R_BGLine_FX" map="ui/event_golden_glow" camera="bg_glow2" hittest="false"/>
					</Panel>
					<Panel class="PT_R_Content">
						<Label class="PT_R_ClaimState" text="{s:claim_state}"/>
						<Panel id="PT_Rewards"/>
					</Panel>
				</Panel>
			</Button>
		</snippet>
		</snippets>

	<Panel hittest="false" class="PromoEvents_CustomRoot">
		<Panel hittest="false" class="PromoEvents_Custom">
			<Panel class="PromoEvents_Header">
				<Panel class="PE_HeaderContent">
					<Label class="PE_HeaderText" text="#promo_events_header"/>
					<Label class="PE_HeaderHint" text="#promo_events_games_header"/>
				</Panel>
				<TextButton class="PE_Close" text="#close" onactivate="GameUI.ToggleCustomPromoEvents()"/>
			</Panel>
			<Panel class="PromoEvents_Content">
				<Panel class="PE_GamesList_Wrap">
					<Panel id="PE_GamesList_Container"/>
				</Panel>
				<Panel id="PE_TasksList"/>
			</Panel>
			<Panel class="PE_NoTasks">
				<Label text="#promo_events_no_tasks"/>
			</Panel>
		</Panel>
	</Panel>
</root>
