<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c"/>
		<include src="file://{resources}/layout/custom_game/collection/item_tooltip/item_tooltip.css"/>
		<include src="file://{resources}/layout/custom_game/leaderboard/rewards_tooltip/rewards_tooltip.css"/>
		<include src="file://{resources}/layout/custom_game/collection/cosmetics/cosmetics_rarities.css"/>
	</styles>

	<scripts>
		<include src="file://{resources}/layout/custom_game/scripts/utils.js" />
		<include src="file://{resources}/layout/custom_game/leaderboard/rewards_tooltip/rewards_tooltip.js"/>
	</scripts>
	<snippets>
		<snippet name="CI_Item">
			<Panel class="CI_Item">
				<Panel class="CI_Background">
					<Image id="CI_Item_Image">
						<Label class="CI_Item_Count" text="x{d:count}"/>
					</Image>
				</Panel>
				<Panel class="CI_Name_LB_Container"><Label class="CI_Name" text="{s:reward_name}"/></Panel>
			</Panel>
		</snippet>
	</snippets>

	<Panel class="LB_CustomItem_Tooltip" hittest="false" hittestchildren="false" ontooltiploaded="UpdateTooltip()"/>
</root>
